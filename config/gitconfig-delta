# only included by install.sh when delta is installed
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = Nord
	file-style = "bold #7aa2f7"
	file-decoration-style = "#7aa2f7 ul"
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#565f89 box"
	plus-style = "syntax #1f3a2b"
	plus-emph-style = "syntax #2e6b47"
	minus-style = "syntax #3b1f2b"
	minus-emph-style = "syntax #7a2f45"
